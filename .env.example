# Django Backend API
# Development (local Django server)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Production (deployed backend on Vercel)
# NEXT_PUBLIC_API_URL=https://texon-backend.vercel.app
# NEXT_PUBLIC_WS_URL=wss://texon-backend.vercel.app

# Session signing secret (min 32 chars) — set a strong value in production
AUTH_SECRET=texon-dev-secret-min-32-chars-long!!